  "version": "0.1.0",
  "type": "module",
  "description": "Maktabati / مكتبتي — local-first personal library manager (webview)",
  "license": "(MIT OR Apache-2.0)",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --output human",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:logical-css": "node scripts/check-logical-css.mjs",
    "lint:contrast": "node scripts/check-contrast.mjs",
    "lint:tokens": "node scripts/check-tokens-defined.mjs",
    "check": "npm run typecheck && npm run test && npm run lint:logical-css && npm run lint:contrast && npm run lint:tokens"
  },
  "dependencies": {
    "@lucide/svelte": "^1.59.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "bits-ui": "^2.19.5"
  },
  "devDependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.0.0",
    "happy-dom": "^18.0.1",
