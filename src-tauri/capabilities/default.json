{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The single capability granted to the main window. Deliberately minimal: every permission is named here so a review of this one file is a review of the whole surface (ADR-0003, docs/02-architecture.md §6).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-set-focus",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-inner-position",
    "core:window:allow-outer-position",
    "core:window:allow-inner-size",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:webview:allow-internal-toggle-devtools",
    "core:app:allow-app-hide",
    "core:app:allow-app-show",
    "core:tray:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "opener:allow-open-url",
    "opener:allow-open-path",
    "store:default"
  ]
}
